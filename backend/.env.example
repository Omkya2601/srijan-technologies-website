# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/srijan_dev?schema=public"

# Server
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed to call this API (comma-separated for several,
# e.g. https://srijan.vercel.app,https://www.yourdomain.com)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Seeded admin account (used by prisma/seed.js)
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@srijantechnologies.com
ADMIN_PASSWORD=ChangeMe123!
